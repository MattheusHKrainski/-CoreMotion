# Copie para .env.local e preencha. NUNCA versione o arquivo .env.local.

# URI de conexão PostgreSQL usada pelas rotas de API no servidor.
# Painel Supabase > Project Settings > Database > Connection string > "Session pooler".
# Se a senha for redefinida, atualize somente aqui.
DATABASE_URL=postgresql://<usuario>:<senha>@<host-do-pooler>:5432/postgres

# Chaves públicas do projeto Supabase (Project Settings > API).
# São seguras para o navegador, pois a segurança real está nas políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-chave-anon>

# TLS do banco: certificado da CA do pooler (opcional; use se a verificação falhar com CA própria)
# DATABASE_SSL_CA=
# Modo demonstração: dados fictícios de fixtures/ e sessão local. Desligado por padrão.
NEXT_PUBLIC_DEMO_MODE=false
